# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Database ---
DATABASE_URL=postgresql+asyncpg://training:training@localhost:5432/training

# --- Auth (single user) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# --- Integrations (code-complete, needed to go live) ---
# Claude (plan-ingestion agent)
ANTHROPIC_API_KEY=
# Gmail auto-pull (OAuth client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Tidepool (glucose + pump)
TIDEPOOL_EMAIL=
TIDEPOOL_PASSWORD=
# Dexcom (if pulled directly rather than via Tidepool)
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
