# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Database ---
DATABASE_URL=postgresql+asyncpg://training:training@localhost:5432/training

# --- Auth (single user) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# --- Integrations (code-complete, needed to go live) ---
# Claude (plan-ingestion agent)
ANTHROPIC_API_KEY=
# MCP server at /mcp for external clients (Claude Code/Desktop). Unset = /mcp not mounted.
# Any long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
# NOTE: one shared token acting as the owner account — treat it as a credential.
MCP_TOKEN=
# Gmail auto-pull (OAuth client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Tidepool (glucose + pump)
TIDEPOOL_EMAIL=
TIDEPOOL_PASSWORD=
# Dexcom (if pulled directly rather than via Tidepool)
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
